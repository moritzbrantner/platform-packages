{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@moritzbrantner/maps": ["../../packages/maps/src/index.ts"],
      "@moritzbrantner/parallel-text": ["../../packages/parallel-text/src/index.ts"],
      "@moritzbrantner/storytelling": ["../../packages/storytelling/src/index.ts"],
      "@moritzbrantner/storytelling/three": ["../../packages/storytelling/src/three.tsx"],
      "@moritzbrantner/ui": ["../../packages/ui/src/index.ts"],
      "@moritzbrantner/word-prediction": ["../../packages/word-prediction/src/index.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
