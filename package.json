{
  "name": "platform-packages",
  "private": true,
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "examples/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "create:package": "node scripts/create-package.mjs",
    "dev:playground": "bun run --filter @moritzbrantner/playground dev",
    "lint": "turbo run lint",
    "preview:playground": "bun run --filter @moritzbrantner/playground preview",
    "build:playground": "bun run --filter @moritzbrantner/playground build",
    "test:e2e": "playwright test",
    "typecheck": "turbo run check-types",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.29.7",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "turbo": "^2.9.3",
    "typescript": "6.0.2",
    "vitest": "^4.1.2"
  }
}
