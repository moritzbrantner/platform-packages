{
  "name": "platform-packages",
  "private": true,
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "examples/*",
    "packages/*",
    "packages/auth-contract",
    "packages/foundation-contract",
    "packages/upload-playbook"
  ],
  "overrides": {
    "@moritzbrantner/ui": "https://registry.npmjs.org/@moritzbrantner/ui/-/ui-0.8.0.tgz"
  },
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "create:package": "node scripts/create-package.mjs",
    "dev": "bun run dev:playground",
    "dev:playground": "bun run --filter @moritzbrantner/playground dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "bun run format:check && bun run lint:ox && bun run lint:packages && bun run lint:repo",
    "lint:ox": "oxlint --format=github",
    "lint:packages": "turbo run lint",
    "lint:repo": "node scripts/verify-package-styles.mjs && node scripts/verify-ui-components.mjs",
    "repo:hygiene": "bash scripts/check_repo_hygiene.sh",
    "preview:playground": "bun run --filter @moritzbrantner/playground preview",
    "build:playground": "bun run --filter @moritzbrantner/playground build",
    "release:build": "bun run build",
    "release:lint": "bun run lint",
    "release:publish": "node scripts/publish-workspace-packages.mjs",
    "release:test": "bun run test",
    "release:typecheck": "bun run typecheck",
    "test:e2e": "playwright test",
    "typecheck": "turbo run check-types",
    "test": "bun test ./scripts/*.test.ts && turbo run test",
    "verify": "bun run repo:hygiene && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.29.7",
    "@playwright/test": "^1.54.2",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "turbo": "^2.9.3",
    "typescript": "6.0.2",
    "vitest": "^4.1.2"
  }
}
