  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@moritzbrantner/linguistics-core": ["../linguistics-core/src/index.ts"],
      "@moritzbrantner/linguistics-corpus": ["../linguistics-corpus/src/index.ts"],
