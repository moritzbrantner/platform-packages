{
  "name": "@moritzbrantner/flat-design",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/platform-packages.git",
    "directory": "packages/flat-design"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core-entry.d.ts",
      "import": "./dist/core-entry.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "import": "./dist/document.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js"
    },
    "./playback": {
      "types": "./dist/playback.d.ts",
      "import": "./dist/playback.js"
    },
    "./sampling": {
      "types": "./dist/sampling.d.ts",
      "import": "./dist/sampling.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@moritzbrantner/ui": "https://registry.npmjs.org/@moritzbrantner/ui/-/ui-0.8.0.tgz"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup src/index.ts src/core-entry.ts src/document.ts src/motion.ts src/playback.ts src/sampling.ts src/schema.ts src/react.tsx --format esm --dts --clean --out-dir dist",
    "lint": "node ../../scripts/verify-package-imports.mjs ./src @/ next/",
    "prepack": "bun run build",
    "check-types": "tsc --noEmit",
    "test": "cd ../.. && vitest run packages/flat-design/src"
  }
}
