{
  "name": "@moritzbrantner/charts",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/platform-packages.git",
    "directory": "packages/charts"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@moritzbrantner/data-density": "^0.1.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "bench:large-data": "node ./scripts/benchmark-large-data.mjs",
    "build": "tsup src/index.ts --format esm --dts --clean --out-dir dist",
    "check-types": "tsc --noEmit",
    "lint": "node ../../scripts/verify-package-imports.mjs ./src @/ next/ && node ../../scripts/verify-package-styles.mjs .",
    "prepack": "bun run build",
    "test": "cd ../.. && vitest run packages/charts/src",
    "verify:release": "bun run check-types && bun run lint && bun run test && bun run build && bun run bench:large-data"
  }
}
