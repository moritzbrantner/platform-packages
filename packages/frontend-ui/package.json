{
  "name": "@moritzbrantner/frontend-ui",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/platform-packages.git",
    "directory": "packages/frontend-ui"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@moritzbrantner/ui": "^0.5.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/browser-playwright": "^4.1.4",
    "lucide-react": "^1.7.0",
    "playwright": "^1.59.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.3.5",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --out-dir dist",
    "build-storybook": "storybook build --output-dir storybook-static",
    "check-types": "tsc --noEmit",
    "lint": "node ../../scripts/verify-package-imports.mjs ./src @/ next/",
    "prepack": "bun run build",
    "storybook": "storybook dev -p 6007 --no-open",
    "test": "cd ../.. && vitest run packages/frontend-ui/src",
    "test:storybook": "../../node_modules/.bin/vitest --config vitest.storybook.config.ts --project=storybook --run"
  }
}
