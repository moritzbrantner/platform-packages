{
  "name": "@moritzbrantner/ui",
  "version": "0.3.1",
  "description": "Shared Tailwind 4 React UI primitives, themes, and layout components for platform packages.",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/platform-packages.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "styles.css",
    "zleek",
    "bobba"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./zleek": {
      "types": "./dist/zleek.d.ts",
      "import": "./dist/zleek.js"
    },
    "./bobba": {
      "types": "./dist/bobba.d.ts",
      "import": "./dist/bobba.js"
    },
    "./themes": {
      "types": "./dist/themes.d.ts",
      "import": "./dist/themes.js"
    },
    "./lib/cn": {
      "types": "./dist/lib/cn.d.ts",
      "import": "./dist/lib/cn.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./styles.css": "./styles.css",
    "./zleek/styles.css": "./zleek/styles.css",
    "./bobba/styles.css": "./bobba/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.7.0",
    "motion": "^12.35.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.14.0",
    "react-resizable-panels": "^4.9.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.14",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/browser-playwright": "^4.1.4",
    "playwright": "^1.59.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.3.5",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "build-storybook": "storybook build --output-dir storybook-static",
    "lint": "node ../../scripts/verify-package-imports.mjs ./src @/ next/ && node ../../scripts/verify-package-styles.mjs .",
    "pack:dry": "npm pack --dry-run --ignore-scripts --json",
    "prepack": "bun run build",
    "check-types": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "test": "cd ../.. && vitest run packages/ui/tests/ui.test.tsx",
    "test:package": "node ./scripts/verify-package.mjs",
    "test:storybook": "vitest --config vitest.storybook.config.ts --project=storybook --run"
  }
}
