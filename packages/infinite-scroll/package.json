{
  "name": "@moritzbrantner/infinite-scroll",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/platform-packages.git",
    "directory": "packages/infinite-scroll"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./tanstack-query": {
      "types": "./dist/tanstack-query.d.ts",
      "import": "./dist/tanstack-query.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@moritzbrantner/ui": "1.1.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-virtual": "3.14.22",
    "@types/react": "19.2.15",
    "react": "19.3.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup src/index.ts src/core.ts src/react.tsx src/tanstack-query.ts --format esm --dts --clean --out-dir dist",
    "lint": "node ../../scripts/verify-package-imports.mjs ./src @/ next/ && node ../../scripts/verify-package-styles.mjs .",
    "prepack": "bun run build",
    "check-types": "tsc --noEmit",
    "test": "cd ../.. && vitest run packages/infinite-scroll/src"
  }
}
