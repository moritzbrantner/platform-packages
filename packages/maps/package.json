{
  "name": "@moritzbrantner/maps",
  "version": "0.1.2",
  "description": "React map components and temporal geo utilities backed by density-aware aggregation.",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/platform-packages.git",
    "directory": "packages/maps"
  },
  "license": "UNLICENSED",
  "files": [
    "dist",
    "styles.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@moritzbrantner/data-density": "^0.1.1",
    "@moritzbrantner/ui": "^0.5.2",
    "@turf/boolean-clockwise": "^7.3.5",
    "@turf/centroid": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "d3-delaunay": "^6.0.4",
    "leaflet": "^1.9.4",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --out-dir dist",
    "bench:temporal-geojson": "bun run ./scripts/benchmark-temporal-geojson.mjs",
    "lint": "node ../../scripts/verify-package-imports.mjs ./src @/ next/ && node ../../scripts/verify-package-styles.mjs .",
    "prepack": "bun run build",
    "check-types": "tsc --noEmit",
    "test": "cd ../.. && vitest run packages/maps/src",
    "pack:dry": "npm pack --dry-run --ignore-scripts --json",
    "verify:release": "bun run check-types && bun run lint && bun run test && bun run build && bun run bench:temporal-geojson && bun run pack:dry"
  }
}
