{
  "name": "@moritzbrantner/maps",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/platform-packages.git",
    "directory": "packages/maps"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "maplibre-gl": "^5.10.0",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/supercluster": "^7.1.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --out-dir dist",
    "lint": "node ../../scripts/verify-package-imports.mjs ./src @/ next/",
    "prepack": "pnpm build",
    "check-types": "tsc --noEmit",
    "test": "cd ../.. && vitest run packages/maps/tests/aggregation.test.ts packages/maps/tests/cluster-area.test.ts packages/maps/tests/temporal-points.test.ts"
  }
}
